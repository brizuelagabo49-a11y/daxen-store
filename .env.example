# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Único correo con acceso al panel /admin (la contraseña se crea en Supabase, nunca aquí)
ADMIN_EMAIL=tu-correo@ejemplo.com
# URL pública del sitio (para enlaces en los mensajes de WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
